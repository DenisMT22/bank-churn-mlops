# Modele de configuration locale.
# Copier ce fichier vers .env et renseigner les valeurs de votre environnement.
# Le fichier .env reel n'est jamais suivi par git.
#
# Le projet fonctionne entierement en local : les variables GCP ci-dessous
# ne servent qu'a un deploiement cloud optionnel et peuvent rester vides.

# --- Google Cloud Platform (optionnel) ---
# Identifiant du projet GCP cible.
PROJECT_ID=
# Region de deploiement, par exemple europe-west1.
REGION=
# Bucket Cloud Storage hebergeant les modeles entraines.
BUCKET_MODELS=
# Bucket Cloud Storage hebergeant les jeux de donnees.
BUCKET_DATA=
# Compte de service utilise par Cloud Run et les pipelines.
SERVICE_ACCOUNT_EMAIL=
#
# Les identifiants ne se stockent pas dans le depot : en local, utiliser
# `gcloud auth application-default login` ; en CI, un secret GitHub.

# --- API ---
# development ou production.
ENVIRONMENT=development
# debug, info, warning ou error.
LOG_LEVEL=info
