# Donnees
# Seule la donnee source est suivie : tout le reste est regenere par le
# pipeline d'entrainement (make train).
data/raw/*.csv
!data/raw/Bank_Churn_Prediction.csv
data/processed/
*.h5
*.hdf5

# Artefacts de modelisation, tous regeneres par make train
models/preprocessor.pkl
src/models/preprocessor.pkl
models/trained/*.pkl
models/trained/*.joblib
models/trained/*.h5
mlruns/
mlflow/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Variables d'environnement
# .env contient la configuration locale, .env.example sert de modele suivi.
.env
.env.local
*.env

# Secrets et identifiants
# Regles ciblees : l'ancienne regle *.json ignorait aussi les JSON
# legitimes du projet, a commencer par models/model_metadata.json.
gcp-key.json
*-key.json
service-account*.json
credentials*.json
.streamlit/secrets.toml

# JSON legitimes a conserver sous suivi malgre les regles ci-dessus
# model_metadata.json est la source de verite des metriques du modele.
!models/model_metadata.json

# Champs volatils de l'entrainement : horodatage et nom du fichier
# produit, differents a chaque execution. Isoles pour que le fichier de
# metriques suivi reste stable.
models/last_run.json

# Resume de reentrainement : artefact regenere, pas une reference
models/retraining_summary.json

# Rapports de monitoring
# Artefacts regeneres par Evidently a chaque execution (34 Mo).
src/monitoring/reports/
monitoring/reports/

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# Temporaire
tmp/
temp/
*.tmp

# Livrables de certification (documents personnels, hors depot)
Livrables Bloc 4/

