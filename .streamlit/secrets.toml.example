# Modele de secrets Streamlit.
# Copier ce fichier vers .streamlit/secrets.toml, qui n'est pas suivi par git.
# Sur Streamlit Community Cloud, ces valeurs se saisissent dans les
# reglages de l'application plutot que dans un fichier.

# Adresse de l'API de prediction interrogee par le tableau de bord.
# En local avec docker compose : http://localhost:8080
API_URL = "http://localhost:8080"
