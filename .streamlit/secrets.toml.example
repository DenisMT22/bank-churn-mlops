# Modèle de secrets Streamlit.
# Copier ce fichier vers .streamlit/secrets.toml, qui n'est pas suivi par git.
#
# Ce fichier est FACULTATIF. Par défaut, le tableau de bord charge le modèle
# dans son propre processus et n'a besoin d'aucun serveur : c'est ce qui lui
# permet d'être hébergé seul sur Streamlit Community Cloud.
#
# Ne définir API_URL que pour interroger une API de prédiction distante à la
# place du modèle local. Sur Streamlit Community Cloud, cette valeur se
# saisit dans les réglages de l'application plutôt que dans un fichier.

# API_URL = "http://localhost:8080"
